{
  "name": "asa-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "generate:api": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/generated/api.d.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "openapi-typescript": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
