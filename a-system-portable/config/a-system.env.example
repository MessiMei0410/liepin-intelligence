# 由 install.sh 根据目标 Mac 自动生成。不要在这里存储密钥。
export A_SYSTEM_HOME="$HOME/A-System"
export A_SYSTEM_ROOT="$A_SYSTEM_HOME/app"
export A_SYSTEM_DB="$A_SYSTEM_ROOT/outputs/talent_system_v3.db"
export A_SYSTEM_HTML="$A_SYSTEM_ROOT/outputs/A系统.html"
export A_SYSTEM_LIEPIN_ROOT="$A_SYSTEM_HOME/integrations/liepin-intelligence"
export A_SYSTEM_LIEPIN_OUTPUTS="$A_SYSTEM_LIEPIN_ROOT/outputs"
export A_SYSTEM_PORT="8765"
export A_SYSTEM_CDP_PORT="9223"
export A_SYSTEM_ARCH="$(uname -m)"

# Agent 模型配置。密钥通过 macOS Keychain 读取，不写入该文件。
export A_SYSTEM_AGENT_BASE_URL="https://max.jojocode.com/v1"
export A_SYSTEM_AGENT_MODEL="gpt-5.5"
export A_SYSTEM_AGENT_KEYCHAIN_SERVICE="cognee-codex-llm"
export A_SYSTEM_AGENT_KEYCHAIN_ACCOUNT="max.jojocode.com"
export A_SYSTEM_AGENT_MAX_WORKERS="1"
