<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ASA DSH 常驻服务器（127.0.0.1:8891）launchd 模板。
  工具链固定在 ~/.dsh/asa-server-toolchain（install.sh 用 dsh/package-lock.json 安装）；
  不能用安装目录里的 node_modules——launchd 进程对其它路径可能无 TCC 授权。
  安装时由 install.sh 把 __HOME__ 替换为实际路径后写入
  ~/Library/LaunchAgents/com.asa.dsh-server.plist。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asa.dsh-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.dsh/asa-server-toolchain/node_modules/.bin/dsh</string>
        <string>--profile</string>
        <string>asa-server</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/.dsh/asa-workspace</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.dsh/asa-server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.dsh/asa-server.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
